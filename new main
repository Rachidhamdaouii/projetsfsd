#include <stdio.h>
#include <string.h>
#include <stdbool.h>

#define MAX_BLOCS 1000
#define TAILLE_BLOC 512
#define MAX_ENREGISTREMENTS (TAILLE_BLOC / sizeof(Enregistrement))
#define MAX_FICHIERS 100

typedef struct {
    int libre; // 1 si le bloc est libre, 0 sinon
} Bloc;

typedef struct {
    char nom[50];
    int taille_en_blocs;
    int taille_en_enregistrements;
    int adresse_premier_bloc;
    char mode_organisation_globale[10];
    char mode_organisation_interne[10];
} Metadonnees;

typedef struct {
    int id;
    char champs[100];
    bool supprime; // Indique si l'enregistrement est supprimé (logique)
} Enregistrement;

typedef struct {
    char nom[50];
    Metadonnees metadonnees;
    Enregistrement enregistrements[MAX_ENREGISTREMENTS * MAX_BLOCS];
    int nb_enregistrements;
} Fichier;

Bloc disque[MAX_BLOCS];
Fichier fichiers[MAX_FICHIERS];
int nb_fichiers = 0;

void initialiser_disque(int total_blocs) {
    for (int i = 0; i < total_blocs; i++) {
        disque[i].libre = 1;
    }
    printf("Mémoire secondaire initialisée avec %d blocs.\n", total_blocs);
}

void afficher_table_allocation(int total_blocs) {
    printf("\n--- Table d'allocation des blocs ---\n");
    for (int i = 0; i < total_blocs; i++) {
        printf("Bloc %d : %s\n", i, disque[i].libre ? "Libre" : "Occupé");
    }
}

void creer_fichier(char *nom, int nb_enregistrements, char *mode_globale, char *mode_interne) {
    if (nb_fichiers >= MAX_FICHIERS) {
        printf("Nombre maximum de fichiers atteint.\n");
        return;

    }

    int blocs_necessaires = (nb_enregistrements + MAX_ENREGISTREMENTS - 1) / MAX_ENREGISTREMENTS;
    if (blocs_necessaires > MAX_BLOCS) {
        printf("Impossible de créer le fichier : taille trop grande.\n");
        return;
    }

    Fichier *fichier = &fichiers[nb_fichiers];
    strcpy(fichier->nom, nom);
    fichier->metadonnees.taille_en_blocs = blocs_necessaires;
    fichier->metadonnees.taille_en_enregistrements = nb_enregistrements;
    fichier->metadonnees.adresse_premier_bloc = -1;
    strcpy(fichier->metadonnees.mode_organisation_globale, mode_globale);
    strcpy(fichier->metadonnees.mode_organisation_interne, mode_interne);
    fichier->nb_enregistrements = 0;

    nb_fichiers++;
    printf("Fichier '%s' créé.\n", nom);
}

void charger_fichier(Fichier *fichier, int total_blocs) {
    int blocs_necessaires = fichier->metadonnees.taille_en_blocs;
    for (int i = 0; i < total_blocs && blocs_necessaires > 0; i++) {
        if (disque[i].libre) {
            disque[i].libre = 0;
            if (fichier->metadonnees.adresse_premier_bloc == -1) {
                fichier->metadonnees.adresse_premier_bloc = i;
            }
            blocs_necessaires--;
        }
    }

    if (blocs_necessaires > 0) {
        printf("Espace insuffisant pour charger le fichier '%s'.\n", fichier->nom);
    } else {
        printf("Fichier '%s' chargé en mémoire.\n", fichier->nom);
    }
}

void inserer_enregistrement(Fichier *fichier, int id, const char *champs) {
    if (fichier->nb_enregistrements >= fichier->metadonnees.taille_en_enregistrements) {
        printf("Impossible d'insérer un nouvel enregistrement : capacité maximale atteinte pour le fichier '%s'.\n", fichier->nom);
        return;
    }

    Enregistrement *enregistrement = &fichier->enregistrements[fichier->nb_enregistrements];
    enregistrement->id = id;
    strcpy(enregistrement->champs, champs);
    enregistrement->supprime = false;
    fichier->nb_enregistrements++;

    printf("Enregistrement ajouté au fichier '%s'. Nombre total : %d.\n", fichier->nom, fichier->nb_enregistrements);
}

void rechercher_enregistrement(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id && !fichier->enregistrements[i].supprime) {
            int bloc = i / MAX_ENREGISTREMENTS;
            int deplacement = i % MAX_ENREGISTREMENTS;
            printf("Enregistrement trouvé : Bloc %d, Déplacement %d.\n", bloc, deplacement);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable dans le fichier '%s'.\n", id, fichier->nom);
}

void suppression_logique(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id) {
            fichier->enregistrements[i].supprime = true;
            printf("Enregistrement avec ID %d marqué comme supprimé dans le fichier '%s'.\n", id, fichier->nom);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable pour suppression logique.\n", id);
}

void suppression_physique(Fichier *fichier) {
    int index = 0;
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (!fichier->enregistrements[i].supprime) {
            fichier->enregistrements[index++] = fichier->enregistrements[i];
        }
    }
    fichier->nb_enregistrements = index;
    printf("Suppression physique effectuée pour le fichier '%s'.\n", fichier->nom);
}

void compactage_fichier(Fichier *fichier) {
    suppression_physique(fichier);
    printf("Compactage du fichier '%s' terminé.\n", fichier->nom);
}

void renommer_fichier(Fichier *fichier, const char *nouveau_nom) {
    strcpy(fichier->nom, nouveau_nom);
    printf("Fichier renommé en '%s'.\n", nouveau_nom);
}

void supprimer_fichier(Fichier *fichier) {
    for (int i = 0; i < fichier->metadonnees.taille_en_blocs; i++) {
        int bloc = fichier->metadonnees.adresse_premier_bloc + i;
        if (bloc < MAX_BLOCS) {
            disque[bloc].libre = 1;
        }
    }

    for (int i = 0; i < nb_fichiers; i++) {
        if (&fichiers[i] == fichier) {
            for (int j = i; j < nb_fichiers - 1; j++) {
                fichiers[j] = fichiers[j + 1];
            }
            nb_fichiers--;
            break;
        }
    }

    printf("Fichier supprimé.\n");
}

void afficher_metadonnees(Fichier *fichier) {
    printf("\n--- Métadonnées du fichier '%s' ---\n", fichier->nom);
    printf("Taille en blocs : %d\n", fichier->metadonnees.taille_en_blocs);
    printf("Taille en enregistrements : %d\n", fichier->metadonnees.taille_en_enregistrements);
    printf("Adresse du premier bloc : %d\n", fichier->metadonnees.adresse_premier_bloc);
    printf("Mode d'organisation globale : %s\n", fichier->metadonnees.mode_organisation_globale);
    printf("Mode d'organisation interne : %s\n", fichier->metadonnees.mode_organisation_interne);
}

void afficher_menu() {
    printf("\n--- Simulateur de Système de Gestion de Fichiers ---\n");
    printf("1. Initialiser la mémoire secondaire\n");
    printf("2. Créer un fichier\n");
    printf("3. Charger un fichier\n");
    printf("4. Afficher la table d'allocation\n");
    printf("5. Afficher les métadonnées d'un fichier\n");
    printf("6. Insérer un enregistrement\n");
    printf("7. Rechercher un enregistrement\n");
    printf("8. Suppression logique d'un enregistrement\n");
    printf("9. Suppression physique des enregistrements supprimés\n");
    printf("10. Compactage d'un fichier\n");
    printf("11. Renommer un fichier\n");
    printf("12. Supprimer un fichier\n");
    printf("13. Quitter\n");
}

