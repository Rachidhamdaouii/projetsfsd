        }
    }

    if (!fichier_trouve) {
        printf("Erreur : Le fichier '%s' n'existe pas en mémoire.\n", nom);
    }
    break;

            case 4:
                afficher_table_allocation(total_blocs);
                break;
            case 5:
    printf("Nom du fichier : ");
    scanf("%s", nom);

    int fichiertrouve = 0;
    for (int i = 0; i < nb_fichiers; i++) {
        if (strcmp(fichiers[i].nom, nom) == 0) {
