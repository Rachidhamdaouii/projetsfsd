#include <stdio.h>
#include <string.h>
#include <stdbool.h>

#define MAX_BLOCS 1000
#define TAILLE_BLOC 512
#define MAX_ENREGISTREMENTS (TAILLE_BLOC / sizeof(Enregistrement))
#define MAX_FICHIERS 100

typedef struct {
    int libre; // 1 si le bloc est libre, 0 sinon
} Bloc;

typedef struct {
    char nom[50];
    int taille_en_blocs;
    int taille_en_enregistrements;
    int adresse_premier_bloc;
    char mode_organisation_globale[10];
    char mode_organisation_interne[10];
} Metadonnees;

typedef struct {
    int id;
    char champs[100];
    bool supprime; // Indique si l'enregistrement est supprimé (logique)
} Enregistrement;


    typedef struct {
    char nom[50];
    Metadonnees metadonnees;
    Enregistrement *enregistrements; // Pointer instead of array
    int nb_enregistrements;
} Fichier;

Bloc disque[MAX_BLOCS];
Fichier fichiers[MAX_FICHIERS];
int nb_fichiers = 0;

void initialiser_disque(int total_blocs) {
    for (int i = 0; i < total_blocs; i++) {
        disque[i].libre = 1;
    }
    printf("Memoire secondaire initialisee avec %d blocs.\n", total_blocs);
}

void afficher_table_allocation(int total_blocs) {
    printf("\n--- Table d'allocation des blocs ---\n");
    for (int i = 0; i < total_blocs; i++) {
        printf("Bloc %d : %s\n", i, disque[i].libre ? "Libre" : "Occupe");
    }
}

void creer_fichier(char *nom, int nb_enregistrements, char *mode_globale, char *mode_interne) {
    if (nb_fichiers >= MAX_BLOCS) {
        printf("Erreur : Nombre maximum de fichiers atteint.\n");
        return;
    }

    int blocs_necessaires = (nb_enregistrements * sizeof(Enregistrement) + TAILLE_BLOC - 1) / TAILLE_BLOC;
    int blocs_disponibles = 0;

    for (int i = 0; i < MAX_BLOCS; i++) {
        if (disque[i].libre) {
            blocs_disponibles++;
        }
    }

    if (blocs_necessaires > blocs_disponibles) {
        printf("Erreur : Espace disque insuffisant pour creer le fichier.\n");
        return;
    }

    Fichier *nouveau_fichier = &fichiers[nb_fichiers++];
    strcpy(nouveau_fichier->nom, nom);
    nouveau_fichier->metadonnees.taille_en_blocs = blocs_necessaires;
    nouveau_fichier->metadonnees.taille_en_enregistrements = nb_enregistrements;
    strcpy(nouveau_fichier->metadonnees.mode_organisation_globale, mode_globale);
    strcpy(nouveau_fichier->metadonnees.mode_organisation_interne, mode_interne);
    nouveau_fichier->enregistrements = malloc(sizeof(Enregistrement) * nb_enregistrements);
    if (!nouveau_fichier->enregistrements) {
        perror("Erreur d'allocation memoire pour les enregistrements");
        exit(1);
    }

    printf("Fichier '%s' cree avec %d blocs necessaires.\n", nom, blocs_necessaires);
}
void charger_fichier(Fichier *fichier, int total_blocs) {
    int blocs_necessaires = fichier->metadonnees.taille_en_blocs;
    for (int i = 0; i < total_blocs && blocs_necessaires > 0; i++) {
        if (disque[i].libre) {
            disque[i].libre = 0;
            if (fichier->metadonnees.adresse_premier_bloc == -1) {
                fichier->metadonnees.adresse_premier_bloc = i;
            }
            blocs_necessaires--;
        }
    }

    if (blocs_necessaires > 0) {
        printf("Espace insuffisant pour charger le fichier '%s'.\n", fichier->nom);
    } else {
        printf("Fichier '%s' charge en mémoire.\n", fichier->nom);
    }
}

void inserer_enregistrement(Fichier *fichier, int id, const char *champs) {
    if (fichier->nb_enregistrements >= fichier->metadonnees.taille_en_enregistrements) {
        printf("Impossible d'inserer un nouvel enregistrement : capacite maximale atteinte pour le fichier '%s'.\n", fichier->nom);
        return;
    }

    Enregistrement *enregistrement = &fichier->enregistrements[fichier->nb_enregistrements];
    enregistrement->id = id;
    strcpy(enregistrement->champs, champs);
    enregistrement->supprime = false;
    fichier->nb_enregistrements++;

    printf("Enregistrement ajoute au fichier '%s'. Nombre total : %d.\n", fichier->nom, fichier->nb_enregistrements);
}

void rechercher_enregistrement(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id && !fichier->enregistrements[i].supprime) {
            int bloc = i / MAX_ENREGISTREMENTS;
            int deplacement = i % MAX_ENREGISTREMENTS;
            printf("Enregistrement trouve : Bloc %d, Deplacement %d.\n", bloc, deplacement);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable dans le fichier '%s'.\n", id, fichier->nom);
}

void suppression_logique(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id) {
            fichier->enregistrements[i].supprime = true;
            printf("Enregistrement avec ID %d marque comme supprimé dans le fichier '%s'.\n", id, fichier->nom);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable pour suppression logique.\n", id);
}

void suppression_physique(Fichier *fichier) {
    int index = 0;
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (!fichier->enregistrements[i].supprime) {
            fichier->enregistrements[index++] = fichier->enregistrements[i];
        }
    }
    fichier->nb_enregistrements = index;
    printf("Suppression physique effectuee pour le fichier '%s'.\n", fichier->nom);
}

void compactage_fichier(Fichier *fichier) {
    suppression_physique(fichier);
    printf("Compactage du fichier '%s' termine.\n", fichier->nom);
}

void renommer_fichier(Fichier *fichier, const char *nouveau_nom) {
    strcpy(fichier->nom, nouveau_nom);
    printf("Fichier renomme en '%s'.\n", nouveau_nom);
}

void supprimer_fichier(Fichier *fichier) {
    for (int i = 0; i < fichier->metadonnees.taille_en_blocs; i++) {
        int bloc = fichier->metadonnees.adresse_premier_bloc + i;
        if (bloc < MAX_BLOCS) {
            disque[bloc].libre = 1;
        }
    }

    for (int i = 0; i < nb_fichiers; i++) {
        if (&fichiers[i] == fichier) {
            for (int j = i; j < nb_fichiers - 1; j++) {
                fichiers[j] = fichiers[j + 1];
            }
            nb_fichiers--;
            break;
        }
    }

    printf("Fichier supprime.\n");
}

void afficher_metadonnees(Fichier *fichier) {
    printf("\n--- Métadonnées du fichier '%s' ---\n", fichier->nom);
    printf("Taille en blocs : %d\n", fichier->metadonnees.taille_en_blocs);
    printf("Taille en enregistrements : %d\n", fichier->metadonnees.taille_en_enregistrements);
    printf("Adresse du premier bloc : %d\n", fichier->metadonnees.adresse_premier_bloc);
    printf("Mode d'organisation globale : %s\n", fichier->metadonnees.mode_organisation_globale);
    printf("Mode d'organisation interne : %s\n", fichier->metadonnees.mode_organisation_interne);
}
void defragmenter_blocs() {
    int index_libre = 0;

    // Parcours de tous les blocs de la mémoire
    for (int i = 0; i < MAX_BLOCS; i++) {
        if (disque[i].libre == 0) { // Si le bloc est occupé
            if (i != index_libre) {
                // Trouve quel fichier occupe ce bloc
                for (int f = 0; f < nb_fichiers; f++) {
                    // On suppose que les fichiers sont stockés dans l'ordre des blocs
                    for (int b = 0; b < fichiers[f].metadonnees.taille_en_blocs; b++) {
                        if (fichiers[f].metadonnees.adresse_premier_bloc + b == i) {
                            // Déplace le bloc vers 'index_libre'
                            disque[i].libre = 1; // Libère le bloc actuel
                            disque[index_libre].libre = 0; // Marque le nouveau bloc comme occupé

                            // Met à jour l'adresse du bloc dans les métadonnées du fichier
                            fichiers[f].metadonnees.adresse_premier_bloc = index_libre;

                            printf("Bloc %d déplacé vers %d\n", i, index_libre);
                            break;
                        }
                    }
                }
            }
            index_libre++; // On avance le pointeur pour le prochain bloc libre
        }
    }

    printf("Défragmentation terminée. Tous les blocs occupés sont maintenant regroupés.\n");
}

