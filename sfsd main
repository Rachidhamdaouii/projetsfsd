}

// Fonction de comparaison pour trier les enregistrements par ID
int comparer_enregistrements(const void *a, const void *b) {
    Enregistrement *enr1 = (Enregistrement *)a;
    Enregistrement *enr2 = (Enregistrement *)b;

    // Comparaison des IDs des deux enregistrements
    return (enr1->id - enr2->id);
}
void creer_fichier(char *nom, int nb_enregistrements, char *mode_globale, char *mode_interne) {
    // Vérification si le nom de fichier existe déjà
    for (int i = 0; i < nb_fichiers; i++) {
        if (strcmp(fichiers[i].nom, nom) == 0) {
            printf(RED "Erreur : Un fichier avec ce nom existe déjà.\n" RESET);
            return;
        }
    }

    // Vérification de l'espace disque disponible
    if (nb_fichiers >= MAX_BLOCS) {
        printf(RED "Erreur : Nombre maximum de fichiers atteint.\n" RESET);
        return;
    }

    int blocs_necessaires = nb_enregistrements / MAX_ENREGISTREMENTS;
    printf("blocs_necessaires %d\n", blocs_necessaires);
    if (nb_enregistrements % MAX_ENREGISTREMENTS != 0) {
        blocs_necessaires = blocs_necessaires + 1;
    }

    int blocs_disponibles = 0;
    for (int i = 0; i < MAX_BLOCS; i++) {
        if (disque[i].libre) {
            blocs_disponibles++;
        }
    }

    if (blocs_necessaires > blocs_disponibles) {
        printf(RED "Erreur : Espace disque insuffisant pour créer le fichier.\n" RESET);
        return;
    }

    Fichier *nouveau_fichier = &fichiers[nb_fichiers++];
    strcpy(nouveau_fichier->nom, nom);
    nouveau_fichier->metadonnees.taille_en_blocs = blocs_necessaires;
    nouveau_fichier->metadonnees.taille_en_enregistrements = nb_enregistrements;
    strcpy(nouveau_fichier->metadonnees.mode_organisation_globale, mode_globale);
    strcpy(nouveau_fichier->metadonnees.mode_organisation_interne, mode_interne);
    nouveau_fichier->enregistrements = malloc(sizeof(Enregistrement) * nb_enregistrements);
    if (!nouveau_fichier->enregistrements) {
        perror("Erreur d'allocation mémoire pour les enregistrements");
        exit(1);
    }

    // Implémentation du mode d'organisation globale
    if (strcmp(mode_globale, "contigue") == 0) {
        // Allocation contiguë des enregistrements dans le disque
        int index_bloc = 0;
        for (int i = 0; i < blocs_necessaires; i++) {
            while (!disque[index_bloc].libre) {
                index_bloc++;
            }
            disque[index_bloc].libre = 0; // Marquer le bloc comme occupé
            nouveau_fichier->enregistrements->champs[i] = index_bloc;
            index_bloc++;
        }
        printf("Mode global : contigu (allocation contiguë des blocs).\n");
    } else if (strcmp(mode_globale, "chainee") == 0) {
        // Allocation chaînée des enregistrements dans le disque
        int index_bloc = 0;
        int prev_bloc = -1; // Aucun bloc précédent au départ
        for (int i = 0; i < blocs_necessaires; i++) {
            while (!disque[index_bloc].libre) {
                index_bloc++;
            }
            disque[index_bloc].libre = 0; // Marquer le bloc comme occupé
            if (prev_bloc != -1) {
                // Chaîner l'enregistrement précédent avec le nouveau bloc
                nouveau_fichier->enregistrements->champs[i - 1] = index_bloc;
            }
            nouveau_fichier->enregistrements->champs[i] = index_bloc;
            prev_bloc = index_bloc; // Le bloc actuel devient le précédent pour la prochaine itération
            index_bloc++;
        }
        printf("Mode global : chaînée (allocation chaînée des blocs).\n");
    } else {
        printf("Mode global non reconnu : %s\n", mode_globale);
        return;
    }

    // Implémentation du mode d'organisation interne
    if (strcmp(mode_interne, "trie") == 0) {
        // Tri des enregistrements par un critère (par exemple, par une clé primaire)
        qsort(nouveau_fichier->enregistrements, nb_enregistrements, sizeof(Enregistrement), comparer_enregistrements);
        printf("Mode interne : trié (enregistrements triés).\n");
    } else if (strcmp(mode_interne, "nontrie") == 0) {
        // Les enregistrements sont ajoutés sans tri
        printf("Mode interne : nontrié (enregistrements ajoutés sans tri).\n");
    } else {
        printf("Mode interne non reconnu : %s\n", mode_interne);
        return;
    }

    printf(GREEN "Fichier '%s' créé avec %d blocs nécessaires.\n" RESET, nom, blocs_necessaires);
}


