void inserer_enregistrement(Fichier *fichier, int id, const char *champs) {
    // Check if the ID already exists
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id && !fichier->enregistrements[i].supprime) {
            printf("Erreur : Un enregistrement avec l'ID %d existe déjà dans le fichier '%s'.\n", id, fichier->nom);
            return;
        }
    }

    // Check if there's space for a new record
    if (fichier->nb_enregistrements >= fichier->metadonnees.taille_en_enregistrements) {
        printf("Impossible d'insérer un nouvel enregistrement : capacité maximale atteinte pour le fichier '%s'.\n", fichier->nom);
        return;
    }

    // Add the new record
    Enregistrement *enregistrement = &fichier->enregistrements[fichier->nb_enregistrements];
    enregistrement->id = id;
    strcpy(enregistrement->champs, champs);
    enregistrement->supprime = false;
    fichier->nb_enregistrements++;

    printf("Enregistrement ajouté au fichier '%s'. Nombre total : %d.\n", fichier->nom, fichier->nb_enregistrements);
}

void rechercher_enregistrement(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id && !fichier->enregistrements[i].supprime) {
            int bloc = i / MAX_ENREGISTREMENTS;
            int deplacement = i % MAX_ENREGISTREMENTS;
            printf("Enregistrement trouve : Bloc %d, Deplacement %d.\n", bloc, deplacement);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable dans le fichier '%s'.\n", id, fichier->nom);
}

void suppression_logique(Fichier *fichier, int id) {
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (fichier->enregistrements[i].id == id) {
            fichier->enregistrements[i].supprime = true;
            printf("Enregistrement avec ID %d marque comme supprimé dans le fichier '%s'.\n", id, fichier->nom);
            return;
        }
    }
    printf("Enregistrement avec ID %d introuvable pour suppression logique.\n", id);
}

void suppression_physique(Fichier *fichier) {
    int index = 0;
    for (int i = 0; i < fichier->nb_enregistrements; i++) {
        if (!fichier->enregistrements[i].supprime) {
            fichier->enregistrements[index++] = fichier->enregistrements[i];
        }
    }
    fichier->nb_enregistrements = index;
    printf("Suppression physique effectuee pour l'enregistrement '%d' du fichier '%s'.\n" , fichier->nom);
}

void compactage_memoire_secondaire() {
    // Réinitialiser la table d'allocation des blocs
    for (int i = 0; i < MAX_BLOCS; i++) {
        disque[i].libre = 1;  // Marque tous les blocs comme libres
    }

    int index_libre = 0;  // Indice du premier bloc libre

    // Parcours de tous les fichiers
    for (int f = 0; f < nb_fichiers; f++) {
        // Récupérer les métadonnées du fichier
        int adresse_premier_bloc = fichiers[f].metadonnees.adresse_premier_bloc;
        int taille_en_blocs = fichiers[f].metadonnees.taille_en_blocs;

        // Si le fichier occupe des blocs, les déplacer
        if (taille_en_blocs > 0) {
            // Déplacer les blocs du fichier
            for (int i = 0; i < taille_en_blocs; i++) {
                int bloc_courant = adresse_premier_bloc + i;

                // Cherche le prochain bloc libre pour déplacer le bloc
                while (disque[index_libre].libre == 0) {
                    index_libre++;
                }

                // Déplacer le bloc : libérer l'ancien et marquer le nouveau comme occupé
                disque[bloc_courant].libre = 1;    // Libérer le bloc actuel
                disque[index_libre].libre = 0;    // Marquer le nouveau bloc comme occupé

                // Mettre à jour l'adresse du premier bloc dans les métadonnées du fichier
                fichiers[f].metadonnees.adresse_premier_bloc = index_libre;

                printf("Bloc du fichier '%s' déplacé de %d à %d\n", fichiers[f].nom, bloc_courant, index_libre);

                // Avancer l'indice pour le prochain bloc libre
                index_libre++;
            }
        }
    }

    printf("Compactage de la mémoire secondaire terminé. La table d'allocation a été réinitialisée.\n");
}

void renommer_fichier(Fichier *fichier, const char *nouveau_nom) {
    strcpy(fichier->nom, nouveau_nom);
    printf("Fichier renomme en '%s'.\n", nouveau_nom);
}

void supprimer_fichier(Fichier *fichier) {
    for (int i = 0; i < fichier->metadonnees.taille_en_blocs; i++) {
        int bloc = fichier->metadonnees.adresse_premier_bloc + i;
        if (bloc < MAX_BLOCS) {
            disque[bloc].libre = 1;
        }
    }

    for (int i = 0; i < nb_fichiers; i++) {
        if (&fichiers[i] == fichier) {
            for (int j = i; j < nb_fichiers - 1; j++) {
                fichiers[j] = fichiers[j + 1];
            }
            nb_fichiers--;
            break;
        }
    }

    printf("Fichier supprime.\n");
}

