void defragmenter_fichier_par_nom(const char *nom_fichier) {
    // Recherche du fichier par son nom
    Fichier *fichier = NULL;
    for (int f = 0; f < nb_fichiers; f++) {
        if (strcmp(fichiers[f].nom, nom_fichier) == 0) {
            fichier = &fichiers[f];
            break;
        }
    }

    if (fichier == NULL) {
        printf("Erreur : fichier %s non trouvé.\n", nom_fichier);
        return; // Le fichier n'a pas été trouvé
    }

    // Récupération des métadonnées du fichier à défragmenter
    int adresse_premier_bloc = fichier->metadonnees.adresse_premier_bloc;
    int taille_en_blocs = fichier->metadonnees.taille_en_blocs;

    int index_libre = 0; // Indice du premier bloc libre

    // Boucle pour chaque bloc du fichier
    for (int i = 0; i < taille_en_blocs; i++) {
        int bloc_courant = adresse_premier_bloc + i;

        if (disque[bloc_courant].libre == 0 && bloc_courant != index_libre) {
            // Trouve l'adresse du premier bloc libre
            while (disque[index_libre].libre == 0) {
                index_libre++; // Recherche du prochain bloc libre
            }

            // Déplace le bloc du fichier vers le bloc libre
            disque[bloc_courant].libre = 1; // Libère le bloc courant
            disque[index_libre].libre = 0; // Marque le nouveau bloc comme occupé

            // Mise à jour de l'adresse du premier bloc dans les métadonnées du fichier
            fichier->metadonnees.adresse_premier_bloc = index_libre;

            printf("Bloc %d déplacé vers %d pour le fichier %s\n", bloc_courant, index_libre, nom_fichier);
        }

        index_libre++; // Avance le pointeur pour le prochain bloc libre
    }

    printf("Défragmentation du fichier %s terminée. Tous les blocs sont maintenant regroupés.\n", nom_fichier);
}

void vider_memoire_secondaire(int total_blocs) {
    // Réinitialisation de tous les blocs à l'état libre
    for (int i = 0; i < total_blocs; i++) {
        disque[i].libre = 1;
    }

    // Réinitialisation des fichiers et de leur contenu
    nb_fichiers = 0;

    printf(GREEN "La mémoire secondaire a été vidée.\n" RESET);
}

