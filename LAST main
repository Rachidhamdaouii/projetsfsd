// Structure pour un enregistrement

typedef struct {

    int id;

    // Ajoutez d'autres champs selon vos besoins

    char isDeleted;  // Pour la suppression logique

} Record;



// Structure pour les métadonnées

typedef struct {

    char nomfichier[MAX_NOMFICHIER];

    int numBlocks;

    int nb_enregistrements;

    int firstBlockAddress;

    char Globalorganization;  // 'C' pour contiguë, 'L' pour chaînée

    char internorganization;  // 'T' pour trié, 'N' pour non-trié

} Metadata;



// Structure pour un bloc

typedef struct {

    Record* records;

    int nb_enregistrements;

    int nextBlock;  // Pour l'organisation chaînée

    char nomfichier[MAX_NOMFICHIER];  // Pour identifier à quel fichier appartient le bloc

} Block;



// Structure principale pour la mémoire secondaire

typedef struct {

    Block* blocks;

    int totalBlocks;

    int blockSize;  // Facteur de blocage

    char* allocationTable;  // '0' pour libre, '1' pour occupé

    Metadata* fileMetadata;

    int numFiles;

} Memoiresecondaire;



// Fonction d'initialisation de la mémoire secondaire

void initializeMemoiresecondaire(Memoiresecondaire* ms, int numBlocks, int blockSize) {

    ms->totalBlocks = numBlocks;

    ms->blockSize = blockSize;

    ms->numFiles = 0;



    // Allocation de la table d'allocation

    ms->allocationTable = (char*)malloc(numBlocks * sizeof(char));

    for(int i = 0; i < numBlocks; i++) {

        ms->allocationTable[i] = '0';  // Tous les blocs sont libres

    }



    // Allocation des blocs

    ms->blocks = (Block*)malloc(numBlocks * sizeof(Block));

    for(int i = 0; i < numBlocks; i++) {

        ms->blocks[i].records = (Record*)malloc(blockSize * sizeof(Record));

        ms->blocks[i].nb_enregistrements = 0;

        ms->blocks[i].nextBlock = -1;

    }



    // Allocation du tableau de métadonnées

    ms->fileMetadata = (Metadata*)malloc(MAX_FILES * sizeof(Metadata));

}



// Fonction pour créer un nouveau fichier

int Cree_fichier(Memoiresecondaire* ms, const char* nomfichier, int nb_enregistrements,
                 char globalOrg, char internalOrg) {
    if (ms->numFiles >= MAX_FILES) {
        printf("Erreur: Nombre maximum de fichiers atteint\n");
        return -1;
    }

    // Check for duplicate file name
    for (int i = 0; i < ms->numFiles; i++) {
        if (strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {
            printf(RED "Erreur: Un fichier avec ce nom existe déjà\n" RESET);
            return -1;
        }
    }

    // Calcul du nombre de blocs nécessaires
    int blocs_necessaires = (nb_enregistrements + ms->blockSize - 1) / ms->blockSize;

    // Vérification de l'espace disponible
    int blocslibre = 0;
    for (int i = 0; i < ms->totalBlocks; i++) {
        if (ms->allocationTable[i] == '0') blocslibre++;
    }

    if (blocslibre < blocs_necessaires) {
        printf(RED "Erreur: Espace insuffisant pour créer le fichier\n" RESET);
        return -1;
    }

    // Création des métadonnées
    Metadata* meta = &ms->fileMetadata[ms->numFiles];
    strcpy(meta->nomfichier, nomfichier);
    meta->numBlocks = blocs_necessaires;
    meta->nb_enregistrements = nb_enregistrements;
    meta->Globalorganization = globalOrg;
    meta->internorganization = internalOrg;

    // Allocation des blocs selon l'organisation
    if (globalOrg == 'C') {
        // Organisation contiguë
        int startBlock = -1;
        int consecutiveBlocks = 0;

        // Recherche de blocs contigus
        for (int i = 0; i < ms->totalBlocks; i++) {
            if (ms->allocationTable[i] == '0') {
                if (startBlock == -1) startBlock = i;
                consecutiveBlocks++;
                if (consecutiveBlocks == blocs_necessaires) break;
            } else {
                startBlock = -1;
                consecutiveBlocks = 0;
            }
        }

        if (consecutiveBlocks < blocs_necessaires) {
            printf(RED "Erreur: Fragmentation, compactage nécessaire\n" RESET);
            return -1;
        }

        // Allocation des blocs
        meta->firstBlockAddress = startBlock;
        for (int i = 0; i < blocs_necessaires; i++) {
            ms->allocationTable[startBlock + i] = '1';
            strcpy(ms->blocks[startBlock + i].nomfichier, nomfichier);
        }
        printf(GREEN "Fichier créé avec succès\n" RESET);
    } else {
        // Organisation chaînée
        int firstBlock = -1;
        int prevBlock = -1;
        int allocatedBlocks = 0;

        for (int i = 0; i < ms->totalBlocks && allocatedBlocks < blocs_necessaires; i++) {
            if (ms->allocationTable[i] == '0') {
                ms->allocationTable[i] = '1';
                strcpy(ms->blocks[i].nomfichier, nomfichier);

                if (firstBlock == -1) firstBlock = i;
                if (prevBlock != -1) {
                    ms->blocks[prevBlock].nextBlock = i;
                }
                prevBlock = i;
                allocatedBlocks++;
            }
        }
        printf(GREEN "Fichier créé avec succès\n" RESET);

        meta->firstBlockAddress = firstBlock;
        ms->blocks[prevBlock].nextBlock = -1;
    }

    ms->numFiles++;
    return 0;
}




// Fonction pour rechercher un enregistrement par ID

void rechercher_enregistrement(Memoiresecondaire* ms, const char* nomfichier, int id) {

    // Recherche des métadonnées du fichier

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED "Erreur: Fichier non trouve\n" RESET );

        return;

    }



    Metadata* meta = &ms->fileMetadata[fileIndex];

    int currentBlock = meta->firstBlockAddress;



    while(currentBlock != -1) {

        Block* block = &ms->blocks[currentBlock];



        // Recherche dans le bloc

        for(int i = 0; i < block->nb_enregistrements; i++) {

            if(block->records[i].id == id && !block->records[i].isDeleted) {

                printf(GREEN"Enregistrement trouve dans le bloc %d, position %d\n"RESET ,

                       currentBlock, i);

                return;

            }

        }



        // Passage au bloc suivant

        if(meta->Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    printf(RED "Enregistrement avec ce id non trouve\n"RESET );

}



// Fonction pour l'insertion d'un nouvel enregistrement

int inserer_enregistrement(Memoiresecondaire* ms, const char* nomfichier, Record newRecord) {

    // Recherche des métadonnées du fichier

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED"Erreur: Fichier non trouve\n"RESET);

        return -1;

    }



    Metadata* meta = &ms->fileMetadata[fileIndex];

    int currentBlock = meta->firstBlockAddress;



    // Pour l'organisation interne triée

    if(meta->internorganization == 'T') {

        // Trouver la position d'insertion

        while(currentBlock != -1) {

            Block* block = &ms->blocks[currentBlock];



            // Recherche de la position dans le bloc

            int pos = 0;

            while(pos < block->nb_enregistrements && block->records[pos].id < newRecord.id) {

                pos++;

            }



            if(block->nb_enregistrements < ms->blockSize) {

                // Il y a de la place dans ce bloc

                // Décalage des enregistrements

                for(int i = block->nb_enregistrements; i > pos; i--) {

                    block->records[i] = block->records[i-1];

                }

                block->records[pos] = newRecord;

                block->nb_enregistrements++;

                meta->nb_enregistrements++;

                return 0;

            }



            // Passage au bloc suivant

            if(meta->Globalorganization == 'C') {

                currentBlock++;

                if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

            } else {

                currentBlock = ms->blocks[currentBlock].nextBlock;

            }

        }

    } else {

        // Organisation non triée - insertion à la première place libre

        while(currentBlock != -1) {

            Block* block = &ms->blocks[currentBlock];



            if(block->nb_enregistrements < ms->blockSize) {

                block->records[block->nb_enregistrements] = newRecord;

                block->nb_enregistrements++;

                meta->nb_enregistrements++;

                return 0;

            }



            // Passage au bloc suivant

            if(meta->Globalorganization == 'C') {

                currentBlock++;

                if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

            } else {

                currentBlock = ms->blocks[currentBlock].nextBlock;

            }

        }

    }



    printf(RED"Erreur: espace insuffisant dans le fichier\n"RESET);

    return -1;

}



// Fonction pour la suppression logique d'un enregistrement

void supp_log(Memoiresecondaire* ms, const char* nomfichier, int id) {

    // Recherche des métadonnées du fichier

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED "Erreur: Fichier non trouve\n"RESET);

        return;

    }



    Metadata* meta = &ms->fileMetadata[fileIndex];

    int currentBlock = meta->firstBlockAddress;



    while(currentBlock != -1) {

        Block* block = &ms->blocks[currentBlock];



        // Recherche dans le bloc

        for(int i = 0; i < block->nb_enregistrements; i++) {

            if(block->records[i].id == id) {

                block->records[i].isDeleted = 1;

                printf(GREEN"Enregistrement marque comme supprime\n" RESET);

                return;

            }

        }



        // Passage au bloc suivant

        if(meta->Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    printf(RED "Enregistrement avec ce ID non trouve\n" RESET );

}



// Fonction pour le compactage de la mémoire secondaire

void compactage_memoire(Memoiresecondaire* ms) {

    // Création d'une copie temporaire des métadonnées

    Metadata* tempMetadata = (Metadata*)malloc(ms->numFiles * sizeof(Metadata));

    memcpy(tempMetadata, ms->fileMetadata, ms->numFiles * sizeof(Metadata));



    // Réinitialisation de la table d'allocation

    for(int i = 0; i < ms->totalBlocks; i++) {

        ms->allocationTable[i] = '0';

    }



    // Déplacement des fichiers vers le début

    int currentBlock = 0;

    for(int i = 0; i < ms->numFiles; i++) {

        Metadata* meta = &tempMetadata[i];

        int oldFirstBlock = meta->firstBlockAddress;

        meta->firstBlockAddress = currentBlock;



        // Copie des blocs

        if(meta->Globalorganization == 'C') {

            // Organisation contiguë

            for(int j = 0; j < meta->numBlocks; j++) {

                memcpy(&ms->blocks[currentBlock + j],

                       &ms->blocks[oldFirstBlock + j],

                       sizeof(Block));

                ms->allocationTable[currentBlock + j] = '1';

            }

        } else {

            // Organisation chaînée

            int oldBlock = oldFirstBlock;

            int newBlock = currentBlock;



            while(oldBlock != -1) {

                memcpy(&ms->blocks[newBlock],

                       &ms->blocks[oldBlock],

                       sizeof(Block));

                ms->allocationTable[newBlock] = '1';



                if(ms->blocks[oldBlock].nextBlock != -1) {

                    ms->blocks[newBlock].nextBlock = newBlock + 1;

                    newBlock++;

                }

                oldBlock = ms->blocks[oldBlock].nextBlock;

            }

            currentBlock = newBlock;

        }



        currentBlock += meta->numBlocks;

    }



    // Mise à jour des métadonnées

    memcpy(ms->fileMetadata, tempMetadata, ms->numFiles * sizeof(Metadata));

    free(tempMetadata);

}



