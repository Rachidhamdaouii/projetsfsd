                newRecord.isDeleted = 0;

                inserer_enregistrement(&ms, nomfichier, newRecord);

                break;



            case 7:

                printf("Nom du fichier: ");

                scanf("%s", nomfichier);

                printf(" ID de l'enregistrement: ");

                scanf("%d", &id);

                printf(" Type de suppression (1: Logique, 2: Physique): ");

                int deleteType;

                scanf("%d", &deleteType);

                if(deleteType == 1)

                    supp_log(&ms, nomfichier, id);

                else

                    supp_phy(&ms, nomfichier, id);

                break;



            case 8:

                printf(" Nom du fichier: ");

                scanf("%s", nomfichier);

                defragmenter_fichier(&ms, nomfichier);

                break;



            case 9:

                printf("Nom du fichier: ");

                scanf("%s", nomfichier);

                sup_fichier(&ms, nomfichier);

                break;



            case 10:

                printf(" Ancien nom: ");

                scanf("%s", nomfichier);

                char nvNom[MAX_NOMFICHIER];

                printf(" Nouveau nom: ");

                scanf("%s", nvNom);

                renommer_fichier(&ms, nomfichier, nvNom);

                break;



            case 11:

                compactage_memoire(&ms);

                break;



            case 12:

                vider_memoire(&ms);

                break;

        }

    } while(choix != 0);



    // Libération de la mémoire

    for(int i = 0; i < ms.totalBlocks; i++) {

        free(ms.blocks[i].records);

    }

    free(ms.blocks);

    free(ms.allocationTable);

    free(ms.fileMetadata);



    return 0;

}

