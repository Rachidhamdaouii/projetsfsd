// Fonction pour la suppression physique d'un enregistrement

void supp_phy(Memoiresecondaire* ms, const char* nomfichier, int id) {

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED"Erreur: Fichier non trouve\n"RESET);

        return;

    }



    Metadata* meta = &ms->fileMetadata[fileIndex];

    int currentBlock = meta->firstBlockAddress;

    int found = 0;



    while(currentBlock != -1 && !found) {

        Block* block = &ms->blocks[currentBlock];



        for(int i = 0; i < block->nb_enregistrements; i++) {

            if(block->records[i].id == id) {

                // Suppression physique - décalage des enregistrements

                for(int j = i; j < block->nb_enregistrements - 1; j++) {

                    block->records[j] = block->records[j + 1];

                }

                block->nb_enregistrements--;

                meta->nb_enregistrements--;

                found = 1;

                break;

            }

        }



        if(meta->Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    if(found) {

        printf(GREEN"Enregistrement supprime physiquement\n"RESET);

    } else {

        printf(RED"Enregistrement non trouve\n"RESET);

    }

}



// Fonction pour défragmenter un fichier

void defragmenter_fichier(Memoiresecondaire* ms, const char* nomfichier) {

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED"Erreur: Fichier non trouve\n"RESET);

        return;

    }



    Metadata* meta = &ms->fileMetadata[fileIndex];



    // Création d'un tableau temporaire pour stocker les enregistrements valides

    Record* tempRecords = (Record*)malloc(meta->nb_enregistrements * sizeof(Record));

    int validCount = 0;



// Collecte des enregistrements valides

    int currentBlock = meta->firstBlockAddress;

    while(currentBlock != -1) {

        Block* block = &ms->blocks[currentBlock];



        for(int i = 0; i < block->nb_enregistrements; i++) {

            if(!block->records[i].isDeleted) {

                tempRecords[validCount++] = block->records[i];

            }

        }



        if(meta->Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    // Réinitialisation des blocs

    currentBlock = meta->firstBlockAddress;

    int recordIndex = 0;



    while(currentBlock != -1 && recordIndex < validCount) {

        Block* block = &ms->blocks[currentBlock];

        block->nb_enregistrements = 0;



        // Remplissage du bloc avec les enregistrements valides

        while(recordIndex < validCount && block->nb_enregistrements < ms->blockSize) {

            block->records[block->nb_enregistrements++] = tempRecords[recordIndex++];

        }



        if(meta->Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= meta->firstBlockAddress + meta->numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    meta->nb_enregistrements = validCount;

    free(tempRecords);

    printf(GREEN"Defragmentation terminee\n"RESET);

}



// Fonction pour renommer un fichier

void renommer_fichier(Memoiresecondaire* ms, const char* oldName, const char* nvNom) {

    int fileIndex = -1;



    // Vérifier si le nouveau nom existe déjà

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nvNom) == 0) {

            printf(RED"Erreur: Le nouveau nom existe deja\n"RESET);

            return;

        }

    }



    // Trouver le fichier à renommer

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, oldName) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED"Erreur: Fichier non trouve\n"RESET);

        return;

    }



    // Mettre à jour le nom dans les métadonnées

    strcpy(ms->fileMetadata[fileIndex].nomfichier, nvNom);



    // Mettre à jour le nom dans les blocs

    int currentBlock = ms->fileMetadata[fileIndex].firstBlockAddress;

    while(currentBlock != -1) {

        strcpy(ms->blocks[currentBlock].nomfichier, nvNom);



        if(ms->fileMetadata[fileIndex].Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= ms->fileMetadata[fileIndex].firstBlockAddress +

                              ms->fileMetadata[fileIndex].numBlocks) break;

        } else {

            currentBlock = ms->blocks[currentBlock].nextBlock;

        }

    }



    printf(GREEN"Fichier renomme avec succes\n"RESET);

}



// Fonction pour supprimer un fichier

void sup_fichier(Memoiresecondaire* ms, const char* nomfichier) {

    int fileIndex = -1;

    for(int i = 0; i < ms->numFiles; i++) {

        if(strcmp(ms->fileMetadata[i].nomfichier, nomfichier) == 0) {

            fileIndex = i;

            break;

        }

    }



    if(fileIndex == -1) {

        printf(RED"Erreur: Fichier non trouve\n"RESET);

        return;

    }



    // Libérer les blocs

    int currentBlock = ms->fileMetadata[fileIndex].firstBlockAddress;

    while(currentBlock != -1) {

        ms->allocationTable[currentBlock] = '0';



        if(ms->fileMetadata[fileIndex].Globalorganization == 'C') {

            currentBlock++;

            if(currentBlock >= ms->fileMetadata[fileIndex].firstBlockAddress +

                              ms->fileMetadata[fileIndex].numBlocks) break;

        } else {

            int nextBlock = ms->blocks[currentBlock].nextBlock;

            ms->blocks[currentBlock].nextBlock = -1;

            currentBlock = nextBlock;

        }

    }



    // Décaler les métadonnées

    for(int i = fileIndex; i < ms->numFiles - 1; i++) {

        ms->fileMetadata[i] = ms->fileMetadata[i + 1];

    }

    ms->numFiles--;



    printf(GREEN"Fichier supprime avec succes\n"RESET);

}



// Fonction pour vider la mémoire secondaire

void vider_memoire(Memoiresecondaire* ms) {

    // Réinitialiser la table d'allocation

    for(int i = 0; i < ms->totalBlocks; i++) {

        ms->allocationTable[i] = '0';

    }



// Réinitialiser les blocs

    for(int i = 0; i < ms->totalBlocks; i++) {

        ms->blocks[i].nb_enregistrements = 0;

        ms->blocks[i].nextBlock = -1;

        ms->blocks[i].nomfichier[0] = '\0';

    }



    // Réinitialiser les métadonnées

    ms->numFiles = 0;



    printf("Memoire secondaire videe\n");

}



